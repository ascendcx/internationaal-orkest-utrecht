# Base URL for media files (images and video). Optional.
# Defaults to the current Cloudflare R2 public address when unset.
# Set this to move media to a custom domain or CDN without a code change.
VITE_MEDIA_BASE_URL=https://pub-a951c77d806041b192717a4428bf1a9b.r2.dev

# Form submissions (server side only, set these in Vercel project settings, never commit values).
# Resend API key used by client/api/submit.ts to send form emails.
RESEND_API_KEY=
# Where form submissions are delivered. Comma separated list allowed.
FORM_TO_EMAIL=
# Sender address on a domain verified in Resend, e.g. "IOU Website <forms@your-verified-domain>".
FORM_FROM_EMAIL=
